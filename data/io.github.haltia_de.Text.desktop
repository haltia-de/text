[Desktop Entry]
Type=Application
Name=Notepad
Name[ru]=Блокнот
Comment=Plain text, easy to read
Comment[ru]=Простой текст, легко читать
Exec=haltia-text %F
Icon=io.github.haltia_de.Text
Terminal=false
Categories=GTK;Utility;TextEditor;
Keywords=text;notes;editor;заметки;текст;блокнот;
StartupNotify=true
MimeType=text/plain;
X-B8K-Home=true
X-B8K-Replaces=text
X-Haltia-Home=true
X-Haltia-Replaces=text
X-Flatpak-RenamedFrom=io.github.trudenboy.Text.desktop;
